# Copy this file to secrets.yaml (which is gitignored) and fill in real values.
#   cp secrets.yaml.example secrets.yaml
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Fallback hotspot password (>= 8 chars) if Wi-Fi can't connect.
ap_password: "fallback-ap-password"

# ESPHome native API encryption key. Generate a fresh 32-byte base64 key:
#   openssl rand -base64 32
encryption_key: "GENERATE_A_BASE64_32_BYTE_KEY"

# Password gating ESPHome OTA uploads.
ota_password: "YOUR_OTA_PASSWORD"
