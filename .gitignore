# ---- SECRETS / CREDENTIALS — never commit (public repo) ----
secrets.yaml
**/secrets.yaml
*.key

# ---- Build-system re-downloadable / generated ----
.esphome/
**/.esphome/
__pycache__/
*.pyc
.pio/
.piolibdeps/

# ---- Deploy/packaging outputs (regenerable; OTA zips carry baked creds) ----
ota/*.zip
*.ota.bin
*.factory.bin

# ---- Vendor (Shelly) proprietary firmware — do NOT redistribute ----
firmware/
*.img
# Exception: our OWN generic empty littlefs, a build input for the bridge
# package (not a Shelly artifact). Must ship so github-sourced builds have it.
!components/shelly_wall_dimmer/bridge_fs_empty.img

# ---- Reverse-engineering + emulation artifacts (not needed to build) ----
analysis/
qemu/
tools/

# ---- Design/RE notes (not a build input) ----
CLAUDE.md

# ---- Local dev environment / scratch — never commit -------------------------
# These are untracked but were NOT ignored, so a blanket `git add -A` swept
# 10,000+ files (the whole venv, an embedded clone) into a commit once. Listed
# explicitly so that cannot happen again.
esphome-venv/
component/
playground/
ota/
DEV_REFERENCE.md
example/_pinmap.yaml
